{
  "name": "pai-api-local-poc",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "PAI Digital F2: diagnóstico local y contratos técnicos L2",
  "main": ".local-build/functions/index.js",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "check:contracts": "tsc -p tsconfig.contracts.json",
    "build": "npm run check:boundaries && npm run check:contracts && node scripts/clean-local-build.mjs && tsc -p tsconfig.json",
    "pretest": "npm run build",
    "test": "node --test tests/*.test.mjs",
    "demo:backend": "npm run build && node scripts/demo-backend.mjs",
    "prestart": "npm run build",
    "start": "node scripts/start-local.mjs",
    "storage:start": "node scripts/start-storage.mjs",
    "sql:diagnose": "node scripts/sql-diagnostic.mjs",
    "test:sql": "node --test tests/integration/sql-connectivity.test.mjs"
  },
  "dependencies": {
    "@azure/functions": "4.16.5",
    "jose": "6.2.12"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "azurite": "3.37.0",
    "msnodesqlv8": "5.6.0",
    "mssql": "12.7.10",
    "typescript": "5.7.3"
  }
}
